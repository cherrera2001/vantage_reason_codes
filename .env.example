# Copy this file to .env and fill it in. .env is git-ignored -- never commit it.

# Server URL, no trailing slash, e.g. https://mycompany.seeq.site
SEEQ_URL=

# Access key (Seeq: user menu > Access Keys > Create). The key ID goes here...
SEEQ_ACCESS_KEY=
# ...and the key's secret (the "password" shown once at creation) goes here.
SEEQ_PASSWORD=

# Optional: Vantage room ID (UUID from the room URL). Overrides VANTAGE_ROOM_ID in the script.
VANTAGE_ROOM_ID=
